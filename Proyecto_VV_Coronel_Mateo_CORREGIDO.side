      "name": "CP01_Login_Exitoso",
      "commands": [
        {
          "id": "51d7b1b4-e822-45e1-adfa-9df2cd707503",
          "comment": "Abrir SauceDemo",
          "command": "open",
          "target": "/",
          "targets": [],
          "value": ""
        },
        {
          "id": "15ba4695-aa9a-46c9-bfb8-7d2eadd418c6",
          "comment": "",
          "command": "setWindowSize",
          "target": "1280x900",
          "targets": [],
          "value": ""
        },
        {
          "id": "baba6d15-e0d5-4c9e-9a8d-9bf2aef5a7db",
          "comment": "Ajuste: 'type' falla en Firefox (initKeyEvent is not a function); se llena user-name con executeScript",
          "command": "executeScript",
          "target": "var e=document.getElementById('user-name');var s=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value').set;s.call(e,'standard_user');e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}));",
          "targets": [],
          "value": ""
        },
        {
          "id": "0f9c352f-6c2c-4fae-a2b1-bad4d0480528",
          "comment": "Ajuste: 'type' falla en Firefox (initKeyEvent is not a function); se llena password con executeScript",
          "command": "executeScript",
          "target": "var e=document.getElementById('password');var s=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value').set;s.call(e,'secret_sauce');e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}));",
          "targets": [],
          "value": ""
        },
        {
          "id": "513172d1-6d2b-4023-82f7-5c03a80da182",
          "comment": "",
          "command": "click",
          "target": "id=login-button",
          "targets": [
            [
              "id=login-button",
              "id"
            ],
            [
              "css=#login-button",
              "css:finder"
            ],
            [
              "xpath=//input[@id='login-button']",
              "xpath:attributes"
            ]
          ],
          "value": ""
        },
        {
          "id": "5f62215b-7552-4dfe-8fc1-46a92f06b1ed",
          "comment": "Esperar el catálogo",
